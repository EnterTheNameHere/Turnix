{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnix.local/schemas/asi/terminology-inference.schema.json",
  "title": "ASI Terminology Inference",
  "description": "Schema for terminology proposals produced by TerminologyInferrer workflows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "candidateId",
    "docId",
    "batchId",
    "proposedTerm",
    "normalizedKey",
    "candidateType",
    "sourcePresence",
    "whyItMatters",
    "riskIfAcceptedIncorrectly",
    "recommendedAction",
    "sourceHints",
    "quality"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "terminology_inference"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable ID for this terminology inference. Suggested form: ti:<DOC_ID>:<normalizedKey>."
    },
    "docId": {
      "type": "string",
      "minLength": 1
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "proposedTerm": {
      "type": "string",
      "minLength": 1
    },
    "normalizedKey": {
      "type": "string",
      "minLength": 1
    },
    "candidateType": {
      "type": "string",
      "enum": [
        "possible_source_term",
        "asi_alias_only",
        "possible_boundary_phrase",
        "possible_relation_name",
        "possible_section_anchor",
        "reject_or_replace"
      ]
    },
    "sourcePresence": {
      "type": "string",
      "enum": [
        "literal",
        "variant_spelling",
        "not_literal_but_strongly_implied",
        "not_present_weakly_inferred",
        "unsupported"
      ]
    },
    "whyItMatters": {
      "type": "string",
      "minLength": 1
    },
    "riskIfAcceptedIncorrectly": {
      "type": "string",
      "minLength": 1
    },
    "recommendedAction": {
      "type": "string",
      "enum": [
        "supervisor_review",
        "accept_as_asi_alias",
        "consider_source_patch",
        "reject",
        "defer"
      ]
    },
    "suggestedIndexUse": {
      "type": "string",
      "enum": [
        "none",
        "alias",
        "term_literal",
        "term_context",
        "boundary",
        "relation",
        "section_anchor"
      ],
      "default": "none"
    },
    "sourceHints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceHint"
      }
    },
    "relatedItemIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedDecisionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "searchText": {
      "type": "string"
    },
    "quality": {
      "$ref": "#/$defs/quality"
    }
  },
  "$defs": {
    "sourceHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocId"
      ],
      "properties": {
        "sourceDocId": {
          "type": "string",
          "minLength": 1
        },
        "sourceFile": {
          "type": "string"
        },
        "sectionHint": {
          "type": "string"
        },
        "lineHint": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "reviewState"
      ],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "needs-review"
          ]
        },
        "reviewState": {
          "type": "string",
          "enum": [
            "generated",
            "reviewed",
            "accepted",
            "rejected",
            "superseded",
            "needs-supervisor-decision"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
