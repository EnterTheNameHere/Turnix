{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnix.local/schemas/asi/audit-decision.schema.json",
  "title": "ASI Audit Decision",
  "description": "Schema for audit decisions written by ASI batch or cross-batch audit workflows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "decisionId",
    "batchId",
    "decision",
    "targetItemIds",
    "summary",
    "rationale",
    "quality"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "audit_decision"
    },
    "decisionId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable ID for this audit decision. Suggested form: audit:<batch-slug>:<decision-kind>:<normalizedKey>."
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "batch",
        "cross-batch",
        "document",
        "item"
      ],
      "default": "batch"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept_for_index",
        "accept_as_alias",
        "accept_as_boundary",
        "accept_as_relation",
        "reject_noise",
        "reject_duplicate",
        "split_contexts",
        "merge_with_existing",
        "source_clarification_candidate",
        "terminology_inference_candidate",
        "needs_supervisor_decision",
        "defer"
      ]
    },
    "targetItemIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "literalKey": {
      "type": "string",
      "description": "Optional literal term/key when the decision concerns same-spelling or same-key items."
    },
    "normalizedKey": {
      "type": "string",
      "description": "Optional normalized key used for matching."
    },
    "indexerInstruction": {
      "type": "string",
      "description": "Instruction to the indexer, such as create term literal plus term context cards."
    },
    "sourcePatchRecommendation": {
      "type": "string",
      "enum": [
        "none",
        "consider",
        "needs_supervisor_decision",
        "approved_elsewhere"
      ],
      "default": "none"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "crossDocumentRisk": {
      "type": "string"
    },
    "relatedDocIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedDecisionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    }
  },
  "$defs": {
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "reviewState"
      ],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "needs-review"
          ]
        },
        "reviewState": {
          "type": "string",
          "enum": [
            "generated",
            "reviewed",
            "accepted",
            "rejected",
            "superseded",
            "needs-supervisor-decision"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
