{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnix.local/schemas/asi/index-card.schema.json",
  "title": "ASI Index Card",
  "description": "Schema for one assistant semantic index runtime routing card.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "cardId",
    "kind",
    "key",
    "normalizedKey",
    "summary",
    "searchText",
    "routing",
    "sourceRefs",
    "quality"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "index_card"
    },
    "cardId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable index card ID. Physical file location is storage only and is not semantic authority."
    },
    "kind": {
      "description": "Runtime routing card category. Index cards are routing metadata, not canonical Turnix authority.",
      "oneOf": [
        {
          "const": "document",
          "description": "Document-level routing card for a canonical DOC_ID, its domain, ownership, and non-ownership hints."
        },
        {
          "const": "term_literal",
          "description": "Literal spelling lookup card, such as isRequired. Use when the same literal may have one or more context-specific meanings."
        },
        {
          "const": "term_context",
          "description": "Context-specific meaning of a literal term, usually scoped by DOC_ID and domain, such as isRequired in DA-11 PackRequest grammar."
        },
        {
          "const": "boundary",
          "description": "X-is-not-Y or authority-boundary routing card, such as stateUpdate is not committed state mutation."
        },
        {
          "const": "relation",
          "description": "Cross-document or cross-concept relation routing card, such as transport disconnect is not Job cancellation."
        },
        {
          "const": "alias",
          "description": "Search or retrieval alias card. Alias cards do not imply the source uses or defines the alias unless sourceRefs prove it."
        },
        {
          "const": "implementation_hint",
          "description": "Implementation-facing routing hint. This may point to code/schema/runtime relevance but does not become implementation authority."
        },
        {
          "const": "other",
          "description": "Fallback card kind for useful routing metadata that does not fit current categories. Use sparingly."
        }
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "normalizedKey": {
      "type": "string",
      "minLength": 1
    },
    "batchId": {
      "type": "string"
    },
    "docId": {
      "type": "string",
      "description": "Primary document owner or context document when applicable."
    },
    "contextKey": {
      "type": "string",
      "description": "Required by convention for term_context and useful for scoped meanings."
    },
    "context": {
      "type": "string",
      "description": "Human-readable context describing where this card applies."
    },
    "requiresContext": {
      "type": "boolean",
      "description": "True when a literal term/key needs context selection before routing."
    },
    "contextCards": {
      "type": "array",
      "description": "Card IDs for context-specific cards, usually used by term_literal cards.",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "searchText": {
      "type": "string",
      "minLength": 1,
      "description": "Search-oriented text. It may repeat terms and aliases intentionally."
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loadFirst",
        "candidateLoad",
        "loadIfNeeded",
        "doNotTreatAsAuthority"
      ],
      "properties": {
        "loadFirst": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadHint"
          }
        },
        "candidateLoad": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadHint"
          }
        },
        "loadIfNeeded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadHint"
          }
        },
        "doNotTreatAsAuthority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonAuthorityHint"
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confusableWith": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedCardIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceItemIds",
        "decisionIds"
      ],
      "properties": {
        "sourceItemIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceDocIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    }
  },
  "$defs": {
    "loadHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docId",
        "role"
      ],
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "nonAuthorityHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docId",
        "reason"
      ],
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confidence": {
      "oneOf": [
        {
          "const": "high",
          "description": "Strongly supported by source or accepted workflow evidence."
        },
        {
          "const": "medium",
          "description": "Reasonably supported but may need later review or cross-document confirmation."
        },
        {
          "const": "low",
          "description": "Weak or tentative support; use cautiously."
        },
        {
          "const": "needs-review",
          "description": "Requires audit, supervisor review, or stronger source evidence before relying on it."
        }
      ]
    },
    "reviewState": {
      "oneOf": [
        {
          "const": "generated",
          "description": "Generated by a workflow and not yet reviewed."
        },
        {
          "const": "reviewed",
          "description": "Reviewed, but not necessarily accepted as final or authoritative routing metadata."
        },
        {
          "const": "accepted",
          "description": "Accepted for its intended ASI workflow purpose."
        },
        {
          "const": "rejected",
          "description": "Rejected for its intended ASI workflow purpose."
        },
        {
          "const": "superseded",
          "description": "Replaced by a newer or better record."
        },
        {
          "const": "needs-supervisor-decision",
          "description": "Requires supervisor or user decision before downstream use."
        }
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "reviewState"
      ],
      "properties": {
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "reviewState": {
          "$ref": "#/$defs/reviewState"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
