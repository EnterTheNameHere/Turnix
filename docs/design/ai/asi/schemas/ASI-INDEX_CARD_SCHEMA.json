{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnix.local/schemas/asi/index-card.schema.json",
  "title": "ASI Index Card",
  "description": "Schema for one assistant semantic index runtime routing card.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "cardId",
    "kind",
    "key",
    "normalizedKey",
    "summary",
    "searchText",
    "routing",
    "sourceRefs",
    "quality"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "index_card"
    },
    "cardId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable index card ID. Physical file location is storage only and is not semantic authority."
    },
    "kind": {
      "type": "string",
      "enum": [
        "document",
        "term_literal",
        "term_context",
        "boundary",
        "relation",
        "alias",
        "section_anchor",
        "implementation_hint",
        "other"
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "normalizedKey": {
      "type": "string",
      "minLength": 1
    },
    "batchId": {
      "type": "string"
    },
    "docId": {
      "type": "string",
      "description": "Primary document owner or context document when applicable."
    },
    "contextKey": {
      "type": "string",
      "description": "Required by convention for term_context and useful for scoped meanings."
    },
    "context": {
      "type": "string",
      "description": "Human-readable context describing where this card applies."
    },
    "requiresContext": {
      "type": "boolean",
      "description": "True when a literal term/key needs context selection before routing."
    },
    "contextCards": {
      "type": "array",
      "description": "Card IDs for context-specific cards, usually used by term_literal cards.",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "searchText": {
      "type": "string",
      "minLength": 1,
      "description": "Search-oriented text. It may repeat terms and aliases intentionally."
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loadFirst",
        "candidateLoad",
        "loadIfNeeded",
        "doNotTreatAsAuthority"
      ],
      "properties": {
        "loadFirst": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadHint"
          }
        },
        "candidateLoad": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadHint"
          }
        },
        "loadIfNeeded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadHint"
          }
        },
        "doNotTreatAsAuthority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonAuthorityHint"
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confusableWith": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedCardIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceRefs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceItemIds",
        "decisionIds"
      ],
      "properties": {
        "sourceItemIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisionIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceDocIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    }
  },
  "$defs": {
    "loadHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docId",
        "role"
      ],
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "nonAuthorityHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docId",
        "reason"
      ],
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "reviewState"
      ],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "needs-review"
          ]
        },
        "reviewState": {
          "type": "string",
          "enum": [
            "generated",
            "reviewed",
            "accepted",
            "rejected",
            "superseded",
            "needs-supervisor-decision"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
