{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnix.local/schemas/asi/extracted-item.schema.json",
  "title": "ASI Extracted Item",
  "description": "Schema for one assistant semantic index extracted item produced from one canonical source document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "itemId",
    "docId",
    "batchId",
    "kind",
    "key",
    "normalizedKey",
    "summary",
    "sourceHints",
    "searchText",
    "quality"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "extracted_item"
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable ID for this extracted item. Suggested form: extract:<DOC_ID>:<kind>:<normalizedKey>:<number>."
    },
    "docId": {
      "type": "string",
      "minLength": 1
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "document_domain",
        "term",
        "boundary",
        "relation",
        "alias",
        "source_clarification_observation",
        "section_anchor",
        "implementation_hint",
        "other"
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "description": "Human-facing key, literal term, boundary phrase, or relation name."
    },
    "normalizedKey": {
      "type": "string",
      "minLength": 1,
      "description": "Deterministic normalized form used for matching and sorting."
    },
    "context": {
      "type": "string",
      "description": "Optional local context explaining where this item applies."
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sourceHints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceHint"
      }
    },
    "routingHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loadFirst": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadHint"
          }
        },
        "candidateLoad": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadHint"
          }
        },
        "loadIfNeeded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loadHint"
          }
        },
        "doNotTreatAsAuthority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonAuthorityHint"
          }
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confusableWith": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "searchText": {
      "type": "string",
      "minLength": 1,
      "description": "Search-oriented text. It may repeat terms and aliases intentionally."
    },
    "sourceClarificationHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggested",
        "reason"
      ],
      "properties": {
        "suggested": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "quality": {
      "$ref": "#/$defs/quality"
    }
  },
  "$defs": {
    "sourceHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceDocId"
      ],
      "properties": {
        "sourceDocId": {
          "type": "string",
          "minLength": 1
        },
        "sourceFile": {
          "type": "string"
        },
        "sectionHint": {
          "type": "string"
        },
        "lineHint": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "loadHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docId",
        "role"
      ],
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "nonAuthorityHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docId",
        "reason"
      ],
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence",
        "reviewState"
      ],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "needs-review"
          ]
        },
        "reviewState": {
          "type": "string",
          "enum": [
            "generated",
            "reviewed",
            "accepted",
            "rejected",
            "superseded",
            "needs-supervisor-decision"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
