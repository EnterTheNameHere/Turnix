/* Experimental canonical-source candidate; original TXT remains authoritative. */
{
  "id": "design.platform",
  "family": "design",
  "title": "ACTANT DESIGN - PLATFORM IDENTITY AND PRINCIPLES",
  "status": "evolving",
  "description": "Defines Actant's platform identity, motivations, and enduring principles.",
  "purpose": "Explains why Actant exists and the boundaries shared by its subsystems. It does NOT prescribe detailed algorithms, storage, APIs, or runtime protocols.",
  "sections": [
    {
      "id": "platform-identity",
      "title": "PLATFORM IDENTITY",
      "content": [
        {
          "text": "Actant is a standalone, local-first runtime platform for modular Applications. It provides orchestration, controlled execution, continuity, and explicit authority boundaries."
        },
        {
          "text": "Actant is AI-oriented because AI applications frequently combine models, tools, long-running work, memory, and independent activities. The platform also supports non-AI applications and workloads."
        },
        {
          "text": "A model, assistant, Application, Pack, runtime Host, and Actant platform are different concepts. None alone defines the platform."
        },
        {
          "text": "Actant's identity comes from its contracts and guarantees rather than a language, user interface, process, transport, or vendor."
        }
      ]
    },
    {
      "id": "the-problem-actant-addresses",
      "title": "THE PROBLEM ACTANT ADDRESSES",
      "content": [
        {
          "text": "A conversation transcript is not a complete execution model. Work may be concurrent, ongoing, interrupted, or independent of conversational turns and user-visible responses."
        },
        {
          "text": "Independent Applications may need to cooperate, use shared engines, and preserve meaningful state across activity and lifetime changes."
        },
        {
          "text": "Actant provides common foundations for these problems rather than requiring every creator to invent its own lifecycle, storage, communication, and diagnostic conventions."
        },
        {
          "text": "The objective is reusable, comprehensible platform guarantees, not to hide all uncertainty or automate every domain decision."
        }
      ]
    },
    {
      "id": "continuity-and-authority",
      "title": "CONTINUITY AND AUTHORITY",
      "content": [
        {
          "text": "Persistence-first means that continuity requirements constrain system design from the beginning, including state, communications, recovery, and handling of incomplete operations."
        },
        {
          "text": "Persistence is not a universal promise that every transient observation or operation is durably recorded. Contracts define the required evidence and durability at each boundary."
        },
        {
          "text": "Authoritative committed state, runtime memory, trace evidence, acknowledgement, and domain-confirmed outcomes are distinct."
        },
        {
          "text": "Missing information does not prove an action never occurred. Recovery must preserve uncertainty where evidence is insufficient."
        },
        {
          "text": "An outward-facing failure does not erase Actant's responsibility for unfinished contractual obligations or safe cleanup."
        },
        {
          "text": "Platform and domain authorities remain explicit. Infrastructure cannot silently replace the creator's definition of domain success."
        }
      ]
    },
    {
      "id": "modularity-and-language-independence",
      "title": "MODULARITY AND LANGUAGE INDEPENDENCE",
      "content": [
        {
          "text": "Packs package deployable Applications, content, tests, and code. CodeEntries identify code that appropriate adapters may execute."
        },
        {
          "text": "Adapters realize execution in particular language environments without creating a separate Actant platform for each language."
        },
        {
          "text": "Python is the current execution implementation focus. JavaScript/TypeScript browser sandbox and C# are intended adapter directions, not assertions of completed implementation."
        },
        {
          "text": "Language-specific interfaces may adapt naturally to their host language while maintaining shared platform meanings and guarantees."
        },
        {
          "text": "Sharing an implementation language does not grant Pack-provided code the same authority as platform implementation code."
        },
        {
          "text": "A replaceable component remains accountable for the contracts of the boundary it implements. Replaceability is not permission to alter externally meaningful behavior."
        }
      ]
    },
    {
      "id": "multiple-applications-and-orchestration",
      "title": "MULTIPLE APPLICATIONS AND ORCHESTRATION",
      "content": [
        {
          "text": "A Host can operate multiple Applications with independent identities and lifecycles while managing common facilities where appropriate."
        },
        {
          "text": "Applications can share managed resources such as an AI model server without becoming owners of each other's complete lifecycle."
        },
        {
          "text": "Actant supports ongoing activities beyond request-response chat. A communication peer may be temporarily unavailable while work governed by separate authority continues."
        },
        {
          "text": "Flow coordinates communication relationships, Invocations, Subscriptions, Emits, and the obligations imposed by contracts. Domains retain ownership of intentions and semantic outcomes."
        },
        {
          "text": "Transport is a communication mechanism, not the enduring meaning of a Flow relationship. Transport changes need not erase identity."
        },
        {
          "text": "Implementation and resource decisions are permitted only within the continuity and authority guarantees of the relevant design."
        }
      ]
    },
    {
      "id": "observability-and-engineering-discipline",
      "title": "OBSERVABILITY AND ENGINEERING DISCIPLINE",
      "content": [
        {
          "text": "'Trace or it did not happen' means that unrecorded events cannot later be established as recorded evidence merely by inference."
        },
        {
          "text": "Tracing is structured runtime evidence, not a replacement for authoritative state or a demand to trace every machine instruction."
        },
        {
          "text": "Useful failure reports preserve context. Local error handling should not silently erase diagnostically meaningful information."
        },
        {
          "text": "Architectural Tests exercise accepted invariants, including interruption and recovery. Optimization cannot redefine them."
        },
        {
          "text": "Creators have broad freedom. Actant favors clear interfaces, observable failures, and containment over needless prohibition."
        }
      ]
    },
    {
      "id": "design-boundaries",
      "title": "DESIGN BOUNDARIES",
      "content": [
        {
          "text": "This document establishes platform identity and cross-cutting principles. It does not specify concrete data formats, APIs, storage layouts, transports, adapter internals, or Flow protocols."
        },
        {
          "text": "The relevant owning design area defines exact subsystem semantics. Avoid promoting examples into platform-wide requirements."
        },
        {
          "text": "For the orientation and document map, begin with:",
          "references": [
            "design/index.txt"
          ]
        },
        {
          "text": "For platform contracts and creator-facing doctrine, consult:",
          "references": [
            "docs/design/DA-01_PROJECT_INVARIANTS_AND_PHILOSOPHY.txt",
            "docs/design/DA-02_PLATFORM_CORE_CONTRACT_BOUNDARIES_AND_IMPLEMENTATION_INDEPENDENCE.txt",
            "docs/design/DD-01_TURNIX_CREATOR_INTERACTION_DOCTRINE.txt",
            "docs/design/DD-02_TURNIX_INTERFACE_DESIGN_RULES.txt",
            "docs/design/DD-03_TURNIX_CROSS_LANGUAGE_INTERFACE_DOCTRINE.txt"
          ]
        },
        {
          "text": "For tracing semantics, consult:",
          "references": [
            "design/area/tracing.txt"
          ]
        },
        {
          "text": "For detailed persistence and Flow contracts, consult the applicable design-area specifications and their accepted working references. Do not infer completed implementation from design."
        }
      ]
    }
  ]
}
