/* Experimental canonical-source candidate; original TXT remains authoritative. */
{
  "id": "design.architecture",
  "family": "design",
  "title": "ACTANT DESIGN - ARCHITECTURAL COMPONENTS AND RESPONSIBILITIES",
  "status": "evolving",
  "description": "Maps Actant's major conceptual components and responsibility boundaries.",
  "purpose": "Provides a concise architecture map for assistants and contributors. Subsystem documents own exact behavior, interfaces, and protocols. It does NOT prescribe implementation topology or internal data structures.",
  "sections": [
    {
      "id": "architectural-view",
      "title": "ARCHITECTURAL VIEW",
      "content": [
        {
          "text": "Actant is a platform of contract-governed responsibilities, not a prescribed set of processes, objects, or implementation languages."
        },
        {
          "text": "A Host operates multiple Applications and manages shared runtime facilities while preserving Application-specific identities."
        },
        {
          "text": "Packs supply modular Applications, CodeEntries, content, and tests. Adapters execute CodeEntries in appropriate language environments."
        },
        {
          "text": "The conceptual layers in this document are responsibility boundaries, not mandatory modules or execution order."
        }
      ]
    },
    {
      "id": "host-applications-and-shared-facilities",
      "title": "HOST, APPLICATIONS, AND SHARED FACILITIES",
      "content": [
        {
          "text": "The Host is the execution environment for Application runtimes, shared services, lifecycle coordination, and resource boundaries."
        },
        {
          "text": "Applications may run concurrently, with independent lifetimes, purposes, and work even when they use common managed services."
        },
        {
          "text": "Shared capabilities, including model servers, are managed with explicit ownership and resource authority, not duplicated solely because separate Applications request them."
        },
        {
          "text": "Jobs may have lifetimes independent of listeners and individual communication relationships. Do not equate all Job completion with completion of a request-response exchange."
        },
        {
          "text": "Suspension of an Application or resource is not automatically Flow Quiescence, Unexpected Unavailability, or Termination."
        }
      ]
    },
    {
      "id": "packs-codeentries-and-adapters",
      "title": "PACKS, CODEENTRIES, AND ADAPTERS",
      "content": [
        {
          "text": "A Pack is a deployable container of executable and other content."
        },
        {
          "text": "CodeEntries are executable units loaded through adapters. Adapter choice reflects an execution language or environment."
        },
        {
          "text": "The same programming language on both sides of a boundary does not grant Pack code platform-internal authority."
        },
        {
          "text": "Adapters and language-specific interfaces preserve the platform contracts despite different native runtime facilities."
        },
        {
          "text": "Python is the current implementation focus. JavaScript/TypeScript browser sandbox and C# execution are intended future directions."
        }
      ]
    },
    {
      "id": "domain-flow-and-actant-responsibilities",
      "title": "DOMAIN, FLOW, AND ACTANT RESPONSIBILITIES",
      "content": [
        {
          "text": "Domains own their intentions, independently executing Jobs, externally meaningful effects, and the meaning of success."
        },
        {
          "text": "Flow owns orchestration knowledge: relationships, Messages, communications, attempts, acknowledgements, Results, contracts, progression, and outstanding contractual obligations."
        },
        {
          "text": "Actant provides execution and lifecycle support, persistence, Transport and routing facilities, recovery, and resource authority."
        },
        {
          "text": "Flow coordinates Invocations, Subscriptions, and Emits without becoming a universal domain workflow or purpose interpreter."
        },
        {
          "text": "Transport is a replaceable communication realization; Transport receipt alone is not durable Flow admission or domain success."
        },
        {
          "text": "A callback outcome is not automatically proof of domain-purpose success or of authoritative MemoryValue commitment."
        },
        {
          "text": "A caller-visible Flow error does not end Actant's obligations to reconcile, recover, or safely clean up outstanding work."
        }
      ]
    },
    {
      "id": "memory-durability-and-recovery",
      "title": "MEMORY, DURABILITY, AND RECOVERY",
      "content": [
        {
          "text": "MemoryValueSystem holds semantic values, revisions, references, staged changes, and authoritative commitment under its contracts."
        },
        {
          "text": "Runtime-held information and committed persistent values are distinct. Durable evidence is relative to the stated recovery boundary, not automatically every piece of runtime state."
        },
        {
          "text": "For applicable potentially effectful actions, record sufficient intent or admission before the effect boundary, and record the observed outcome afterward as the relevant contract requires."
        },
        {
          "text": "On recovery, restore the last durably known semantic state first; reconcile it with the participants and external reality afterward."
        },
        {
          "text": "An uncertain callback completion is not permission to execute the same callback again. A distinct new Job needs its own authority."
        },
        {
          "text": "Missing history or NotFound is scoped evidence, not universal proof of non-execution. Retention meets contractual obligations."
        },
        {
          "text": "Persistence degradation is a reportable condition. A Result can be available without having the promised durability; delivery and failure reporting are governed by the actual contract."
        }
      ]
    },
    {
      "id": "communication-and-continuity",
      "title": "COMMUNICATION AND CONTINUITY",
      "content": [
        {
          "text": "Logical relationship identity and operation identity persist across runtime and Transport changes where contracts require."
        },
        {
          "text": "Acknowledgement of request admission, execution observation, domain confirmation, and authoritative commit are different facts."
        },
        {
          "text": "Contracts define which acknowledgement or confirmation settles a particular obligation. Stronger confirmation is not universal."
        },
        {
          "text": "Quiescence, Unexpected Unavailability, and Termination have different meanings. Absence alone does not terminate a relation."
        },
        {
          "text": "Multiple subscribers or listeners can have distinct obligations; one recipient's absence need not stop unrelated domain work."
        },
        {
          "text": "Retry of a logical Message is not automatically permission to repeat potentially effectful domain execution."
        },
        {
          "text": "Exact retention, retry policy, timing, scheduling, and resource arbitration are owned by applicable design contracts."
        }
      ]
    },
    {
      "id": "tracing-and-verification",
      "title": "TRACING AND VERIFICATION",
      "content": [
        {
          "text": "Tracing emits structured evidence of runtime activity, identities, ordering, and recorded relationships for later interpretation."
        },
        {
          "text": "Trace evidence is distinct from authoritative committed state. Consumers must not present inference as observed evidence."
        },
        {
          "text": "Domain owners identify which meaningful actions require tracing. Trace coverage is not a command to record every implementation step."
        },
        {
          "text": "Architectural Tests verify guarantees and interruption boundaries. Implementation and optimization must preserve their meaning."
        }
      ]
    },
    {
