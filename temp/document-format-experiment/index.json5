    {
      "id": "document-authoring",
      "title": "DOCUMENT AUTHORING",
      "content": [
        {
          "text": "Preserve domain ownership and the contracts documented by the owning design area; do not weaken tests to fit faulty code."
        },
        {
          "text": "Design specifications follow CMR-01 ASCII-79 and fixed two-digit hierarchical rule numbering. Literal filenames remain intact."
        },
        {
          "text": "Reference documents by their real paths and defined responsibilities."
        }
      ]
