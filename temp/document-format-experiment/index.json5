/* Experimental canonical-source candidate; original TXT remains authoritative. */
{
  "id": "design.index",
  "family": "design",
  "title": "ACTANT DESIGN - PLATFORM ORIENTATION AND INDEX",
  "status": "evolving",
  "description": "Entry point for understanding Actant and finding relevant platform design.",
  "purpose": "Provides the essential platform model for assistants and contributors. Detailed behavior belongs to the referenced design areas. It does NOT define subsystem APIs or implementation mechanisms.",
  "sections": [
    {
      "id": "actant-at-a-glance",
      "title": "ACTANT AT A GLANCE",
      "content": [
        {
          "text": "Actant is a local-first, persistence-first, modular platform for running and coordinating multiple Applications."
        },
        {
          "text": "AI is a primary motivation, but Actant is not limited to AI. Intended uses include assistants, AI buddies, model orchestration, completion, analysis, tests, games, and simulations."
        },
        {
          "text": "Orchestration extends beyond turn-based chat and reconstructing state from conversational history alone."
        },
        {
          "text": "A shared Host supports concurrent Applications with distinct lifecycles and shared managed facilities."
        }
      ]
    },
    {
      "id": "design-principles",
      "title": "DESIGN PRINCIPLES",
      "content": [
        {
          "text": "Platform truth is defined by contracts, authority, and guarantees, not one language, process layout, model, or implementation stack."
        },
        {
          "text": "Persistence is foundational: promised state and obligations must remain recoverable across interruptions and failures."
        },
        {
          "text": "Known outcomes, uncertainty, trace evidence, and authoritative committed values must remain distinguishable."
        },
        {
          "text": "Domain code owns intentions and meaning; Flow orchestrates communication and contractual progression."
        },
        {
          "text": "A reported Flow error does not end Actant's responsibility for unresolved recovery, reconciliation, or cleanup."
        },
        {
          "text": "'Trace or it did not happen' is an evidentiary principle: missing trace evidence cannot prove an event occurred. Trace evidence is not automatically committed state."
        },
        {
          "text": "Architectural Tests protect correctness before optimization."
        },
        {
          "text": "Actant protects platform integrity while respecting creators' freedom to experiment and choose implementation approaches."
        }
      ]
    },
    {
      "id": "runtime-concepts",
      "title": "RUNTIME CONCEPTS",
      "content": [
        {
          "text": "The Host manages Application runtimes and shared services."
        },
        {
          "text": "An Application has its own purpose, identity, and lifecycle."
        },
        {
          "text": "Packs are deployable units for Applications, code, content, and tests. CodeEntries identify executable units within Packs."
        },
        {
          "text": "Adapters execute CodeEntries through appropriate runtimes. Python is the current focus; JavaScript/TypeScript browser sandbox and C# are intended future directions, not completed features."
        },
        {
          "text": "Flow coordinates Invocations, Subscriptions, Emits, relationships, and replaceable Transports while respecting domain authority."
        },
        {
          "text": "MemoryValueSystem manages semantic values, revisions, transactions, authoritative commitment, retention, and recovery."
        },
        {
          "text": "Tracing records structured runtime evidence for later inspection without inventing events not established by the evidence."
        }
      ]
    },
    {
      "id": "documentation-use",
      "title": "DOCUMENTATION USE",
      "content": [
        {
          "text": "This index provides a self-contained orientation and retrieval guide, not the detailed requirements of every component."
        },
        {
          "text": "design/ contains platform design. Refer to other documents for concepts not yet defined by a specific design/ document."
        },
        {
          "text": "Read the design owner for the task and relevant dependencies. Do not interpret illustrative mechanisms as mandatory choices."
        },
        {
          "text": "Working checkpoints preserve design discussions but are not automatically canonical specifications."
        },
        {
          "text": "Distinguish intended features, implemented code, and verified integrated behavior. Report genuine design conflicts explicitly."
        }
      ]
    },
