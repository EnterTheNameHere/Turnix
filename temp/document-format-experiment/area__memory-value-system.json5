/* Experimental canonical-source candidate; original TXT remains authoritative. */
{
  "id": "design.area.memory-value-system",
  "family": "design-area",
  "title": "ACTANT DESIGN AREA - MEMORY VALUE SYSTEM",
  "status": "evolving",
  "description": "Defines the semantic-memory authority, revision, and commitment model.",
  "purpose": "Explains persistent semantic values, reference and transaction boundaries, authority, recovery, and separation from Flow and physical storage. It does NOT prescribe implementation algorithms or storage layouts.",
  "sections": [
    {
      "id": "semantic-memory",
      "title": "SEMANTIC MEMORY",
      "content": [
        {
          "text": "MemoryValueSystem manages language-independent semantic values and their authoritative evolution, not merely storage locations."
        },
        {
          "text": "MemoryValue identifies a logical value. MemoryValueRevision represents a particular revision of its semantic content."
        },
        {
          "text": "Revision existence and authority are distinct. One authority scope resolves one current authoritative revision per value."
        },
        {
          "text": "Multiple physical copies do not create multiple authorities."
        },
        {
          "text": "Runtime availability, semantic visibility, persistence, and authoritative commitment are different properties."
        }
      ]
    },
    {
      "id": "values-references-and-storage",
      "title": "VALUES, REFERENCES, AND STORAGE",
      "content": [
        {
          "text": "ValueRef describes reconstruction of a concrete semantic value; it does not independently confer authority over that value."
        },
        {
          "text": "ValueRef may contain inline material or depend on immutable stored material. Material can be shared where semantically safe."
        },
        {
          "text": "Chunk is an optional immutable storage-material abstraction; it is not a required representation for every value."
        },
        {
          "text": "MemoryStorage and IoManager have distinct responsibilities; IoManager is the managed I/O gateway."
        },
        {
          "text": "Storage realization, material placement, and deduplication strategies do not redefine semantic identity or authority."
        }
      ]
    },
    {
      "id": "definitions-types-and-resolution",
      "title": "DEFINITIONS, TYPES, AND RESOLUTION",
      "content": [
        {
          "text": "MemoryValueDefinition supplies value declaration information. MemoryValueContract is its fully resolved semantic contract."
        },
        {
          "text": "Contract defaults are resolved deterministically from the applicable versioned declaration and default sources."
        },
        {
          "text": "TypeExpression identifies semantic type structure or references a named TypeDefinition. Named types are nominal by default."
        },
        {
          "text": "Type meaning and additional constraints remain distinct. Usage constraints may narrow, not widen, a type's valid domain."
        },
        {
          "text": "Absence, Missing, explicit null, and Error are distinct states. A concrete null does not mean the value was absent."
        },
        {
          "text": "Optional and nullable types express different semantics; their combination must not silently collapse those meanings."
        },
        {
          "text": "Defaults apply only when the relevant concrete state is absent, not merely because a present value is null or invalid."
        }
      ]
    },
    {
      "id": "transactions-and-authority",
      "title": "TRANSACTIONS AND AUTHORITY",
      "content": [
        {
          "text": "Transactions stage changes in hierarchical overlays before their authoritative commitment."
        },
        {
          "text": "Staged values, current runtime values, and committed values are distinct; SaveBundle persists committed values only."
        },
        {
          "text": "An authoritative commit must not be advertised before the durability required by its contract has been established."
        },
        {
          "text": "A conflict must not silently become last-writer-wins. Unrelated state should remain independently committable."
        },
        {
          "text": "Concurrency, nested transactions, snapshots, and fine-grained conflict resolution require their owning detailed design."
        },
        {
          "text": "Transaction rejection, abort, retry, and quarantine must not be confused with a successful authoritative overwrite."
        },
        {
          "text": "Restoration uses the latest trustworthy committed semantic authority rather than arbitrary physical material found on disk."
        }
      ]
    },
    {
      "id": "retention-and-recovery",
      "title": "RETENTION AND RECOVERY",
      "content": [
        {
          "text": "Semantic removal and physical material collection are separate. Removing a value does not require immediate removal of all bytes."
        },
        {
          "text": "Material left by interrupted publication may be orphaned. Orphans are not retroactively promoted into authoritative values."
        },
        {
          "text": "Retention and collection preserve surviving references, contractual obligations, and required recovery evidence."
        },
        {
          "text": "Known loss of a durability guarantee must be visible to relevant consumers without falsely presenting volatile state as durable."
        },
        {
          "text": "An available Result may remain usable under a weaker guarantee even when promised retention failed, if its contract permits."
        },
        {
          "text": "Restoring storage availability cannot retroactively prove an earlier value was durably committed."
        }
      ]
    },
    {
      "id": "boundaries-with-flow-and-other-domains",
      "title": "BOUNDARIES WITH FLOW AND OTHER DOMAINS",
      "content": [
        {
          "text": "MemoryValueSystem owns semantic value and commitment authority; Flow owns orchestration evidence and contractual progression."
        },
        {
          "text": "Related recovery needs do not imply one mandatory shared ledger, transaction root, or universal co-commit across both systems."
        },
        {
          "text": "Flow confirmation, callback return, and MemoryValue commit are different facts; a contract may require more than one."
        },
        {
          "text": "Language adapters and Pack code access memory through applicable interfaces and authority boundaries, not direct implementation privilege from sharing a programming language."
        },
        {
          "text": "Tracing can describe value operations but is not itself the source of committed MemoryValue authority."
        }
      ]
    },
    {
      "id": "scope-and-sources",
      "title": "SCOPE AND SOURCES",
      "content": [
        {
          "text": "This document defines the conceptual MemoryValueSystem boundary. It does not prescribe storage formats, specific APIs, transaction algorithms, scheduling, or cross-component atomicity mechanisms."
        },
        {
          "text": "For platform context and neighboring orchestration:",
          "references": [
            "design/index.txt",
            "design/platform.txt",
            "design/architecture.txt",
            "design/area/flow.txt"
          ]
        },
        {
          "text": "For related value and storage specifications:",
          "references": [
            "docs/design/DA-04_MEMORY_STATE_AND_AUTHORITATIVE_COMMIT_MODEL.txt",
            "docs/design/DA-05_PAYLOAD_IDENTITY_CHUNKS_AND_VALUEREF_REPRESENTATION.txt",
            "docs/design/DA-07_FILE_IO_READERS_WRITERS_AND_PERSISTENCE_SAFETY.txt"
          ]
        },
        {
          "text": "For accepted MemoryValueSystem design decisions and open questions: Check its newer controlling sections before relying on an earlier conflicting statement or an illustrative mechanism.",
          "references": [
            "temp/memory-value-system/checkpoint-11.txt"
          ]
        }
      ]
    }
  ]
}
