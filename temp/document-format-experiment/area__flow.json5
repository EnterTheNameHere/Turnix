/* Experimental canonical-source candidate; original TXT remains authoritative. */
{
  "id": "design.area.flow",
  "family": "design-area",
  "title": "ACTANT DESIGN AREA - FLOW AND CONTRACTUAL ORCHESTRATION",
  "status": "evolving",
  "description": "Defines the conceptual responsibilities and continuity guarantees of Flow.",
  "purpose": "Explains contract-governed communication, evidence, identity, recovery, and boundaries between Flow, domains, and Actant infrastructure. It does NOT define concrete protocols, storage, or implementation APIs.",
  "sections": [
    {
      "id": "purpose-and-responsibility",
      "title": "PURPOSE AND RESPONSIBILITY",
      "content": [
        {
          "text": "Flow coordinates contractual communication and progression between domain participants across execution and availability changes."
        },
        {
          "text": "Domains own intention, processing meaning, business success, independent Jobs, and domain effects. Flow does not interpret them."
        },
        {
          "text": "Flow owns relationship knowledge, Messages, attempts, acknowledgements, available Results, contracts, progression, and unmet obligations."
        },
        {
          "text": "Actant provides persistence, lifecycle, execution, routing, Transport, resource authority, recovery, and coordination facilities."
        },
        {
          "text": "Flow includes Invocation, Subscription, and Emit semantics. It is not a universal domain workflow engine."
        }
      ]
    },
    {
      "id": "contracts-and-evidence",
      "title": "CONTRACTS AND EVIDENCE",
      "content": [
        {
          "text": "Contracts determine the evidence and guarantees required for admission, delivery, processing, confirmation, and completion."
        },
        {
          "text": "Transport-level receipt is not Flow admission. Flow recognition is not callback execution or source-domain success."
        },
        {
          "text": "A callback returning a value, null, or error is an observed outcome; it is not automatically domain confirmation or commit."
        },
        {
          "text": "Domain confirmations express domain-asserted facts. Flow verifies whether agreed evidence exists; it does not create domain truth."
        },
        {
          "text": "A later causally sufficient Message may acknowledge an earlier obligation without requiring an additional standalone ACK."
        },
        {
          "text": "One communication may satisfy several obligations but need not satisfy all outstanding obligations."
        },
        {
          "text": "A valid Result and failure of a stronger confirmation or durability promise may coexist and must be reported truthfully."
        }
      ]
    },
    {
      "id": "identity-and-relationships",
      "title": "IDENTITY AND RELATIONSHIPS",
      "content": [
        {
          "text": "Relationship and operation identities are logical identities, distinct from Transports, attempts, payload equality, and timestamps."
        },
        {
          "text": "Identities remain unambiguous within the promised recognition scope and survive runtime restoration where contracts require."
        },
        {
          "text": "Quiescence, Unexpected Unavailability, and Termination describe different situations; temporary absence does not equal termination."
        },
        {
          "text": "A relationship retains its identity through quiescence, unexpected unavailability, Transport replacement, and interrupted termination."
        },
        {
          "text": "Completed termination ends that relationship. A newly established relationship has a new identity and does not automatically inherit earlier Invocation or Result history."
        },
        {
          "text": "Independent Jobs may outlive their original relationship without requiring every later relationship to expose their history."
        },
        {
          "text": "Listener-specific obligations remain independent; one unavailable listener need not stop another listener or unrelated domain work."
        }
      ]
    },
    {
      "id": "durability-before-effects",
      "title": "DURABILITY BEFORE EFFECTS",
      "content": [
        {
          "text": "For Actant-managed potentially effectful actions, establish sufficient durable intent or admission before crossing the effect boundary, according to the applicable contract."
        },
        {
          "text": "Record observed outcomes and the evidence needed before further externally observable actions relying on those outcomes."
        },
        {
          "text": "An outgoing send attempt requires sufficient registered intent; recording a send attempt does not prove Flow reception."
        },
        {
          "text": "An effectful callback requires durable admission before entry. Failure to establish required admission forbids callback execution."
        },
        {
          "text": "Durable admission followed by interruption without completion evidence makes callback outcome uncertain. Do not blindly rerun it."
        },
        {
          "text": "Retry of the same logical Message is not permission to execute an effectful callback again. Deduplication must be supported by stable identity and adequate receiver evidence."
        },
        {
          "text": "A new independently identified Job requires separate authority and may duplicate an unresolved earlier external effect."
        }
      ]
    },
    {
      "id": "restoration-and-reconciliation",
      "title": "RESTORATION AND RECONCILIATION",
      "content": [
        {
          "text": "On recovery, restore last durably known semantic state first; reconcile it with present participant and external evidence next."
        },
        {
          "text": "Restore identities, contracts, outstanding Messages, confirmations, callback admission and outcomes, deadlines, and obligations as required. Do not treat restoration as runtime memory cloning."
        },
        {
          "text": "Different participants may hold different valid partial knowledge. Reconcile unsettled obligations using sufficiently scoped evidence."
        },
        {
          "text": "Missing historical information or NotFound is not proof that an action never occurred, failed, or may safely be executed again."
        },
        {
          "text": "Contradictory authoritative outcomes for the same operation indicate a broken guarantee or evidence problem, not merely ordinary asymmetric knowledge. Contain and diagnose truthfully."
        },
        {
          "text": "Retain sufficient evidence for promised recovery, deduplication, and delivery; complete permanent Message history is not required."
        },
        {
          "text": "A caller-visible Flow error never ends Actant's responsibility for remaining reconciliation, recovery, and safe cleanup."
        }
      ]
    },
    {
      "id": "persistence-degradation",
      "title": "PERSISTENCE DEGRADATION",
      "content": [
        {
          "text": "Known durability degradation is first-class information. Relevant Flow consumers can learn that a required promise is unavailable before attempting an action that depends on it."
        },
        {
          "text": "Persistence failure does not automatically mean callback failure, relationship termination, or invalidation of available Results."
        },
        {
          "text": "A Result may be available in runtime memory even when its intended durability could not be established. Report both facts accurately."
        },
        {
          "text": "Delivery under degraded conditions follows the actual contract. Do not send when durable-before-send is a required precondition."
        },
        {
          "text": "Flow may continue independent safe work and communicate failures without falsely claiming unavailable durability guarantees."
        },
        {
          "text": "Later restoration of storage does not retroactively establish durability that was missing at an earlier boundary."
        }
      ]
    },
    {
      "id": "implementation-and-test-boundaries",
      "title": "IMPLEMENTATION AND TEST BOUNDARIES",
      "content": [
        {
          "text": "Contract profiles, retry and retention horizons, scheduling, storage representation, and resource arbitration require their own design decisions and implementation evidence."
        },
        {
          "text": "Flow and MemoryValueSystem have related persistence concerns but no mandatory shared ledger, co-commit, or universal root design."
        },
        {
          "text": "Architectural Tests cover admission-before-effect, crash uncertainty, deduplication, evidence contradictions, and recovery."
        },
        {
          "text": "Favor simple correct behavior and truthful unresolved outcomes before speculative mechanisms or optimization."
        },
        {
          "text": "This document does not specify a Transport protocol, callback API, contract DSL, scheduler, ledger layout, or storage technology."
        }
      ]
    },
    {
      "id": "related-design",
      "title": "RELATED DESIGN",
      "content": [
