{
  "activeProfile": "0-10-30-profile",
  "profiles": {
    "0-10-30-profile": {
      "description": "From the 01:30:00 anchor, use the following 10 minutes of transcript and retain 30 minutes of chat context on each side of that transcript interval.",
      "anchor": "01:30:00",
      "transcriptBeforeSeconds": 0,
      "transcriptAfterSeconds": 600,
      "chatBeforeSeconds": 1800,
      "chatAfterSeconds": 1800
    }
  },
  "activePrompt": "characterization",
  "promptsFile": "prompts.json",
  "transcriptFile": "data/transcript.json",
  "chatFile": "data/chat.txt",
  "outputDirectory": "results",
  "alignment": {
    "wallClockAtMediaZero": "2026-01-01 00:00:00"
  },
  "llm": {
    "provider": "llama.cpp",
    "model": "model-a",
    "providerOptions": {
      "temperature": 0.7,
      "maxTokens": 4096
    }
  },
  "llamaCpp": {
    "manageServer": true,
    "executable": "runtime/llama-server.exe",
    "host": "127.0.0.1",
    "port": 8080,
    "defaultModel": "model-a",
    "startupTimeoutSeconds": 120,
    "models": {
      "model-a": {
        "modelPath": "models/model-a.gguf",
        "contextWindowTokens": 32768,
        "gpuLayers": 99,
        "threads": 12,
        "extraArgs": []
      },
      "model-b": {
        "modelPath": "models/model-b.gguf",
        "contextWindowTokens": 32768,
        "gpuLayers": 99,
        "threads": 12,
        "extraArgs": []
      },
      "model-vision": {
        "modelPath": "models/model-vision.gguf",
        "mmprojPath": "models/model-vision-mmproj.gguf",
        "contextWindowTokens": 32768,
        "gpuLayers": 99,
        "threads": 12,
        "extraArgs": []
      }
    }
  }
}
