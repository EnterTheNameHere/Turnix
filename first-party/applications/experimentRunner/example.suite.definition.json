{
  "schemaId": "actant.experiment.definition@2",
  "experimentId": "two-config-two-repetition-demo",
  "configurations": [
    {"name": "four-threads", "profile": "qwen-four",
     "defaults": {"temperature": 0, "maxTokens": 24, "timeoutSeconds": 30,
                  "chatTemplateKwargs": {"enable_thinking": false}}, "allowedOverrides": ["maxTokens"]},
    {"name": "three-threads", "profile": "qwen-three",
     "defaults": {"temperature": 0, "maxTokens": 24, "timeoutSeconds": 30,
                  "chatTemplateKwargs": {"enable_thinking": false}}, "allowedOverrides": ["maxTokens"]}
  ],
  "conversation": {
    "id": "remember-word", "historyPolicy": "replay-answers",
    "turns": [
      {"id": "t1", "role": "user", "content": "Remember the word amber. Reply briefly."},
      {"id": "t2", "role": "user", "content": "Which word did I ask you to remember?"}
    ]
  },
  "repetitions": 2,
  "errorPolicy": "stop",
  "contextPolicy": "fresh-best-effort"
}
