{
  "schemaId": "actant.experiment.definition@2",
  "experimentId": "two-turn-demo",
  "configurations": [{
    "name": "baseline",
    "profile": "qwen-demo",
    "defaults": {"temperature": 0, "maxTokens": 24, "timeoutSeconds": 30, "chatTemplateKwargs": {"enable_thinking": false}},
    "allowedOverrides": ["maxTokens"]
  }],
  "conversation": {
    "id": "remember-word",
    "historyPolicy": "replay-answers",
    "turns": [
      {"id": "t1", "role": "user", "content": "Remember the word amber. Reply briefly."},
      {"id": "t2", "role": "user", "content": "Which word did I ask you to remember?"}
    ]
  },
  "repetitions": 1,
  "errorPolicy": "stop",
  "contextPolicy": "fresh-best-effort"
}
