{
  "strategy": "actant-native",
  "promptsFile": "prompts.json",
  "workspaceDirectory": "workspace",
  "outputDirectory": "results",
  "analyzers": {
    "ty": {
      "toolId": "ty",
      "arguments": ["check", "{source}"]
    },
    "ruff": {
      "toolId": "ruff",
      "arguments": ["check", "{source}"]
    }
  },
  "llm": {
    "provider": "llama.cpp",
    "model": "materialization-model",
    "providerOptions": {
      "temperature": 0.7,
      "maxTokens": 16384
    }
  },
  "llamaCpp": {
    "manageServer": true,
    "baseUrl": "http://127.0.0.1:8080",
    "contextWindowTokens": 32768,
    "executable": "W:/Tools/llama.cpp/build/bin/llama-server.exe",
    "defaultModel": "materialization-model",
    "models": {
      "materialization-model": {
        "modelPath": "MODEL_PATH.gguf",
        "contextWindowTokens": 32768,
        "gpuLayers": 99,
        "threads": 12,
        "parallelSlots": 1,
        "extraArgs": []
      }
    }
  }
}
